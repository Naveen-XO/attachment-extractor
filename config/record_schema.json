{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Email Attachment Extraction Record",
    "type": "object",
    "required": [
        "record_id",
        "source_file",
        "file_type",
        "extracted_fields",
        "actionable",
        "notes",
        "metadata"
    ],
    "properties": {
        "record_id": {
            "type": "string",
            "pattern": "^rec_\\d{5}$",
            "description": "Unique identifier for this record"
        },
        "source_file": {
            "type": "string",
            "description": "Path to source file from input folder"
        },
        "source_row": {
            "type": [
                "integer",
                "null"
            ],
            "description": "Row number if from CSV, null otherwise"
        },
        "file_type": {
            "type": "string",
            "enum": [
                "pdf",
                "image",
                "csv",
                "document"
            ],
            "description": "Type of source file"
        },
        "extracted_fields": {
            "type": "object",
            "required": [
                "pickup_number",
                "scheduled_date",
                "material",
                "weight",
                "weight_unit",
                "reference_number"
            ],
            "properties": {
                "pickup_number": {
                    "type": "object",
                    "required": [
                        "value",
                        "confidence"
                    ],
                    "properties": {
                        "value": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "confidence": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "extraction_method": {
                            "type": "string",
                            "enum": [
                                "pattern",
                                "llm",
                                "csv_mapping",
                                "none"
                            ]
                        }
                    }
                },
                "scheduled_date": {
                    "type": "object",
                    "required": [
                        "value",
                        "confidence"
                    ],
                    "properties": {
                        "value": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "confidence": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "extraction_method": {
                            "type": "string",
                            "enum": [
                                "pattern",
                                "llm",
                                "csv_mapping",
                                "none"
                            ]
                        }
                    }
                },
                "material": {
                    "type": "object",
                    "required": [
                        "value",
                        "confidence"
                    ],
                    "properties": {
                        "value": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "confidence": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "extraction_method": {
                            "type": "string",
                            "enum": [
                                "pattern",
                                "llm",
                                "csv_mapping",
                                "none"
                            ]
                        }
                    }
                },
                "weight": {
                    "type": "object",
                    "required": [
                        "value",
                        "confidence"
                    ],
                    "properties": {
                        "value": {
                            "type": [
                                "number",
                                "null"
                            ]
                        },
                        "confidence": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "extraction_method": {
                            "type": "string",
                            "enum": [
                                "pattern",
                                "llm",
                                "csv_mapping",
                                "none"
                            ]
                        }
                    }
                },
                "weight_unit": {
                    "type": "object",
                    "required": [
                        "value",
                        "confidence"
                    ],
                    "properties": {
                        "value": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "enum": [
                                "kg",
                                "lbs",
                                "tons",
                                null
                            ]
                        },
                        "confidence": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "extraction_method": {
                            "type": "string",
                            "enum": [
                                "pattern",
                                "llm",
                                "csv_mapping",
                                "none"
                            ]
                        }
                    }
                },
                "reference_number": {
                    "type": "object",
                    "required": [
                        "value",
                        "confidence"
                    ],
                    "properties": {
                        "value": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "confidence": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "extraction_method": {
                            "type": "string",
                            "enum": [
                                "pattern",
                                "llm",
                                "csv_mapping",
                                "none"
                            ]
                        }
                    }
                }
            }
        },
        "actionable": {
            "type": "boolean",
            "description": "True if required fields (pickup_number, scheduled_date, weight) meet confidence threshold"
        },
        "notes": {
            "type": "string",
            "description": "Extraction notes, warnings, or context"
        },
        "metadata": {
            "type": "object",
            "required": [
                "processed_at",
                "extraction_method",
                "average_confidence",
                "processing_time_ms"
            ],
            "properties": {
                "processed_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "ISO 8601 timestamp of processing"
                },
                "processing_time_ms": {
                    "type": "number",
                    "description": "Processing time in milliseconds"
                },
                "extraction_method": {
                    "type": "string",
                    "enum": [
                        "pattern",
                        "llm",
                        "hybrid",
                        "csv_mapping",
                        "ocr",
                        "text",
                        "none"
                    ],
                    "description": "Primary extraction method used"
                },
                "average_confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Average confidence across all fields"
                },
                "ocr_quality": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "OCR quality score if applicable"
                }
            }
        }
    }
}